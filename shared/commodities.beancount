; Shared currency definitions for all ledgers.
; AED is the presentation currency of the UAE entities; EUR is held as a foreign currency.

1900-01-01 commodity AED
  name: "UAE dirham"
  export: "AED"

1900-01-01 commodity EUR
  name: "Euro"
  export: "EUR"

1900-01-01 commodity USD
  name: "US dollar"
  export: "USD"

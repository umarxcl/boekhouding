; Main file XCL MANAGEMENT CONSULTANCIES - FZCO
; Check: bean-check xcl/main.beancount
; Bank entries per month in xcl/2026/MM.beancount, sales invoices in xcl/2026/facturen.beancount (generated by
; scripts/facturen.py), manual journal entries in xcl/2026/adjustments.beancount. Closed months have a git tag xcl-2026-MM.

option "title" "XCL MANAGEMENT CONSULTANCIES - FZCO"
option "operating_currency" "AED"
option "operating_currency" "EUR"
option "render_commas" "TRUE"
option "booking_method" "FIFO"

; Strict: every account must be opened in accounts.beancount, every entry must balance.
plugin "beancount.plugins.check_commodity"
plugin "beancount.plugins.leafonly"

include "../shared/commodities.beancount"
include "../shared/prices.beancount"
include "accounts.beancount"
include "opening.beancount"
include "2026/*.beancount"
